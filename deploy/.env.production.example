# ============================================================
# REGARDS — Production environment template
# Mariage : Malachie & Jessica — 23 mai 2026
# ============================================================
# Copy to .env in Dokploy (or `.env.production` if deploying via plain compose).
# NEVER commit the filled version. All `change-me` values MUST be replaced.

# ---------- PostgreSQL ----------
# Strong random password. Generate: `openssl rand -base64 32 | tr -d '/+='`
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password

# ---------- MinIO (object storage, internal only — not exposed publicly) ----------
# Access key: any short identifier. Secret key: 32+ chars random.
MINIO_ACCESS_KEY=regards-prod-access
MINIO_SECRET_KEY=CHANGE_ME_minio_secret_32_chars_min

# ---------- OPTIONAL: serve media directly from storage (perf) ----------
# By default media bytes stream through the app server (/api/media/file). To
# offload that to object storage, expose MinIO publicly via Traefik (see deploy
# README § Performance) and set its PUBLIC https URL here. The app then 307s the
# browser to short-lived presigned URLs. MUST be public & browser-reachable —
# NEVER "minio:9000" (that internal host broke every image in a past deploy).
# Leave empty to keep the safe proxy behaviour.
# MINIO_PUBLIC_ENDPOINT=https://storage.CHANGE_ME.example.com

# Postgres connection pool size (default 20).
# DB_POOL_MAX=20

# ---------- Admin password (mariés / vous) ----------
# Used to log into /admin. Pick something memorable but strong.
ADMIN_PASSWORD=CHANGE_ME_admin_password

# ---------- Public app URL (HTTPS, no trailing slash) ----------
# MUST be set — middleware.ts uses it for CORS enforcement.
# Example: https://regards.malachie-jessica.fr
NEXT_PUBLIC_APP_URL=https://CHANGE_ME.example.com

# ---------- Google Drive Service Account — OPTIONNEL ----------
# Laissez VIDE pour fonctionner en mode 100% local (MinIO comme seul stockage).
# Si vide :
#   - le cron de sync ne sera pas planifié (pas de spam de logs)
#   - le dashboard admin masque la carte "En attente Drive" et le bouton sync
#   - les uploads, le feed, les downloads marchent normalement
# Pour activer Drive plus tard : voir deploy/google-drive-setup.md, coller le
# JSON single-line ici, décommenter le bloc dans bootstrap.sql, redéployer.
GOOGLE_SERVICE_ACCOUNT_KEY=
