# PostgreSQL
DATABASE_URL=postgresql://regards:regards@localhost:5432/regards

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=regards-access
MINIO_SECRET_KEY=regards-secret-key-change-me
MINIO_BUCKET=regards
MINIO_USE_SSL=false
# OPTIONAL performance: a PUBLIC, browser-reachable storage URL. When set, media
# is served via presigned URLs straight from storage instead of streaming through
# the app server. MUST be a public host (e.g. https://storage.example.com) — NEVER
# the internal "minio:9000", which is unreachable from browsers and breaks images.
# Leave empty to keep proxying through /api/media/file (the safe default).
# MINIO_PUBLIC_ENDPOINT=

# Postgres connection pool size (default 20). Shared by API, cron, processing.
# DB_POOL_MAX=20

# Google Drive
GOOGLE_SERVICE_ACCOUNT_KEY=

# Admin
ADMIN_PASSWORD=admin-change-me

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WEDDING_DATE=2026-05-23